{
  "manifest_version": 3,
  "name": "Cookie Share",
  "version": "1.3.0",
  "description": "Syncs session data (cookies, localStorage, sessionStorage, bearer tokens) to Google Secret Manager for authorized domains",
  "permissions": [
    "cookies",
    "identity",
    "alarms",
    "storage",
    "unlimitedStorage",
    "scripting",
    "activeTab",
    "tabs",
    "webRequest"
  ],
  "optional_host_permissions": ["<all_urls>"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Cookie Share",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://secretmanager.googleapis.com https://accounts.google.com https://oauth2.googleapis.com"
  },
  "oauth2": {
    "client_id": "YOUR_CLIENT_ID_HERE.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/cloud-platform"
    ]
  }
}
